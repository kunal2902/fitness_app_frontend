<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme while the process starts. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Window theme once the process has started: the colour behind the
         Flutter UI. Brand near-black rather than ?android:colorBackground,
         which would flash white on a light-mode device. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/brand_background</item>
    </style>
</resources>
