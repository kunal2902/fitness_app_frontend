<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Needed by the Flutter tool to talk to the running app for hot
         reload and breakpoints. Also present in the main manifest because
         the app itself needs it in release. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Android 9+ blocks plain HTTP by default. Dev talks to
         http://10.0.2.2:3000, so allow cleartext for the dev hosts ONLY,
         and only in debug builds - release stays HTTPS-only. -->
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
